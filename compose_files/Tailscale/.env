# BASE CONFIGURATION
COMMON_PATH=/YOUR_PATH/Isyrr
TZ=America/Sao_Paulo

# TAILSCALE CONFIGURATION
# Get your auth key from: https://login.tailscale.com/admin/settings/keys
# For reusable keys, check "Reusable" and optionally set an expiration time
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXXXXXXX

# OPTIONAL: Subnet routes to advertise (for friend access to services)
# Format: Comma-separated CIDR ranges
# Example: TS_ROUTES=192.168.1.0/24,10.0.0.0/24
# Leave empty if you don't need subnet routing
TS_ROUTES=

# OPTIONAL: FlareSolverr Configuration
LOG_LEVEL=info
LOG_HTML=false
CAPTCHA_SOLVER=none
